<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZENTRALE OWASP-Suppressions fuer ALLE Repos (Karte 420, 08.08.2026).

  WARUM ZENTRAL: Ein Befund, der alle sechs Anwendungen gleichzeitig trifft, musste bisher in
  sechs Dateien einzeln eingetragen werden. Am 08.08.2026 standen deshalb alle sechs Repos
  gleichzeitig auf BREACHED wegen desselben CVE. Sechs Eintraege bedeuten sechs Gelegenheiten,
  einen zu vergessen — und ein vergessener Eintrag sieht aus wie ein echter Fund.
  Projekt-eigene Faelle bleiben in quality/owasp-suppressions.xml des jeweiligen Repos.

  REGEL FUER JEDEN EINTRAG (die Antwort dieser Karte auf "Umgang mit Funden ohne Fix"):

    1. VERSIONS-GEPINNT (exakte @-Version im packageUrl). Zieht die Abhaengigkeit eine neue
       Version, greift die Suppression NICHT mehr und der Fund wird neu bewertet.
       Kein Dauer-Blindflug.
    2. BEGRUENDUNG MIT BELEG, nicht "false positive". Woran ist die Nicht-Betroffenheit
       gemessen worden?
    3. ABLAUFDATUM im Notes-Feld (PRUEFEN-AB). Wer nach diesem Datum vorbeikommt, bewertet neu.
    4. VOLLSTAENDIG. Traegt ein Schwester-Artefakt dieselbe CVE, gehoert es dazu — eine
       Suppression, die nur die Haelfte trifft, sieht nach Kontrolle aus und ist keine
       (Karte 389: tomcat-embed-core gedeckt, tomcat-embed-websocket nicht).
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      CVE-2026-66299 (Tomcat-WebSocket-Chat-Beispiel): Die beiden versions-gepinnten
      Suppressions an tomcat-embed-*@11.0.24 sind seit dem 28.08.2026 entfernt — root
      pinnt Tomcat 11.0.25, und dort ist der CVE behoben (NVD-CPE-Abfrage: 11.0.24
      traegt 11 CVEs, 11.0.25 null). Die Versions-Pinnung haette ohnehin nicht mehr
      gegriffen; der Eintrag waere nur noch totes Gewicht gewesen.
    -->

    <!--
      CVE-2025-15104 — Nu Html Checker (validator.nu), SSRF. CPE-FEHLZUORDNUNG:
      Die CPE lautet validator:validator; der Scanner matcht sie auf JEDE Bibliothek
      mit "validator" im Namen. hibernate-validator (Bean Validation) und
      json-schema-validator (networknt) haben mit validator.nu nichts zu tun —
      dasselbe CVE an zwei fachfremden Bibliotheken ist das bekannte FP-Muster
      (Karte: CPE ist sprachagnostisch). Bewusst OHNE Versions-Pinnung: die
      Fehlzuordnung haengt am Namen, nicht an der Version.
    -->
    <suppress>
        <notes><![CDATA[
            CVE-2025-15104 gilt validator.nu (Nu Html Checker), nicht Hibernate
            Bean Validation. CPE-Fehlzuordnung ueber den Namensbestandteil "validator".
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
            CVE-2025-15104 gilt validator.nu (Nu Html Checker), nicht dem
            networknt-JSON-Schema-Validator. Gleiche CPE-Fehlzuordnung wie oben.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.networknt/json-schema-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!--
      CVE-2025-10543 — Eclipse Paho GO (paho.mqtt.golang), UTF-8-Encoding-Fehler.
      SPRACHFREMD: betrifft die Go-Bibliothek; unsere Jars sind die Java-Clients
      (mqttv3/mqttv5). Klassischer sprachagnostischer CPE-Match.
    -->
    <suppress>
        <notes><![CDATA[
            CVE-2025-10543 betrifft paho.mqtt.golang (Go), nicht die Java-Clients.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.paho/org\.eclipse\.paho\.(client\.mqttv3|mqttv5\.client)@.*$</packageUrl>
        <cve>CVE-2025-10543</cve>
    </suppress>

    <!--
      CVE-2026-54285 — opentelemetry-JS (@opentelemetry/core), Baggage-Header ohne
      Groessenlimit. SPRACHFREMD: betrifft den JavaScript-Client, nicht
      io.opentelemetry:opentelemetry-api (Java).
    -->
    <suppress>
        <notes><![CDATA[
            CVE-2026-54285 betrifft opentelemetry-js, nicht das Java-API-Artefakt.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry/opentelemetry-api@.*$</packageUrl>
        <cve>CVE-2026-54285</cve>
    </suppress>

    <!--
      CVE-2026-23907 / CVE-2026-33929 — Apache PDFBox "ExtractEmbeddedFiles example".
      Beide CVEs betreffen laut NVD ausdruecklich NUR das Beispielprogramm aus dem
      Examples-Modul (Path Traversal beim Entpacken eingebetteter Dateien). Das
      Examples-Modul ist keine Abhaengigkeit unserer Apps — im Klassenpfad liegt nur
      org.apache.pdfbox:pdfbox. PRUEFEN-AB: 2027-03-01 (falls ein spaeterer Fund die
      Kernbibliothek betrifft, greift diese Suppression wegen der CVE-Nummern nicht).
    -->
    <suppress>
        <notes><![CDATA[
            Betrifft nur das PDFBox-Beispielprogramm ExtractEmbeddedFiles, das nicht
            im Klassenpfad liegt. PRUEFEN-AB: 2027-03-01.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/pdfbox@.*$</packageUrl>
        <cve>CVE-2026-23907</cve>
    </suppress>
    <suppress>
        <notes><![CDATA[
            Betrifft nur das PDFBox-Beispielprogramm ExtractEmbeddedFiles, das nicht
            im Klassenpfad liegt. PRUEFEN-AB: 2027-03-01.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.pdfbox/pdfbox@.*$</packageUrl>
        <cve>CVE-2026-33929</cve>
    </suppress>

</suppressions>
